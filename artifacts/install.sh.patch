diff --git a/install.sh b/install.sh
index 14c25cb..7083322 100755
--- a/install.sh
+++ b/install.sh
@@ -11,7 +11,7 @@
 #
 # 环境变量：
 #   FSTDD_SRC   上游代码目录（默认脚本同级 upstream/）
-#   FSTDD_OUT   skill 输出目录（默认 ~/.workbuddy-ai/skills）
+#   FSTDD_OUT   skill 输出目录（默认 ~/.workbuddy/skills，即实例 home + skills）
 #   FSTDD_PY    指定 Python 解释器
 set -euo pipefail
 
@@ -24,12 +24,18 @@ SCRIPT_DIR="$(_winpath "$(cd "$(dirname "$0")" && pwd)")"
 PY="${FSTDD_PY:-}"
 AUTO_YES=0
 
-for arg in "$@"; do
-  case "$arg" in
+# 注意：不能用 `for arg in "$@"` + `shift`。
+# for 的迭代列表在展开时已固定，循环内 shift 不会跳过下一个参数，
+# 导致 `--py /path` 把 "--py" 自身当成解释器路径。改用下标遍历。
+_args=("$@")
+_i=0
+while [[ $_i -lt ${#_args[@]} ]]; do
+  case "${_args[$_i]}" in
     --yes) AUTO_YES=1 ;;
-    --py) shift; PY="${1:-}" ;;
-    --py=*) PY="${arg#*=}" ;;
+    --py) _i=$((_i + 1)); PY="${_args[$_i]:-}" ;;
+    --py=*) PY="${_args[$_i]#*=}" ;;
   esac
+  _i=$((_i + 1))
 done
 
 echo "=============================================="
@@ -85,7 +91,22 @@ else
 fi
 
 # ---------- 3. 安装 skill ----------
-echo "[3/4] 生成 skill"
+# 必须 export：Python 脚本靠环境变量取这两个值，不 export 会退回自己的默认值，
+# 造成「install.sh 提示装到 A 目录、实际写到 B 目录」的错位。
+#
+# 路径必须转成 Windows 形式：Git Bash 的 $HOME 是 /c/Users/xxx，
+# 直接传给 Windows Python 会被解析成 \c\Users\xxx（盘符丢失），
+# 实测会写到 C:\c\Users\... 去。必须经过 cygpath。
+# 默认值取 ~/.workbuddy/skills：本软件实例 home 为 ~/.workbuddy-ai（另一 WorkBuddy 实例的 ~/.workbuddy 不在管理范围）。
+# 加载目录 =「实例自己的 home + skills/」，是按 home 拼装的相对路径，不是写死的目录
+# （codebuddy.js 里 skills/agents/commands/hooks 等作为一组相对目录名被遍历拼接，
+#  所以该文件里 .workbuddy-ai 字面量为 0 次，仍能加载 ~/.workbuddy-ai/skills）。
+# 本机并存两套实例 home（~/.workbuddy 与 ~/.workbuddy-ai），各扫各的，
+# 另一实例安装时用 FSTDD_OUT 覆盖：
+#   FSTDD_OUT=~/.workbuddy-ai/skills ./install.sh
+export FSTDD_OUT="$(_winpath "${FSTDD_OUT:-$HOME/.workbuddy-ai/skills}")"
+export FSTDD_SRC="$(_winpath "${FSTDD_SRC:-$SCRIPT_DIR/upstream}")"
+echo "[3/4] 生成 skill -> $FSTDD_OUT"
 "$PY" "$SCRIPT_DIR/tools/install_workbuddy_skills.py" || {
   echo "[FAIL] 安装脚本执行失败"
   exit 1
@@ -98,8 +119,8 @@ if "$PY" "$SCRIPT_DIR/tools/verify_workbuddy_skills.py"; then
   echo "=============================================="
   echo " 安装完成"
   echo "=============================================="
-  echo " skill 目录: ${FSTDD_OUT:-$HOME/.workbuddy-ai/skills}"
-  echo " 上游资源  : ${FSTDD_SRC:-$SCRIPT_DIR/upstream}"
+  echo " skill 目录: $FSTDD_OUT"
+  echo " 上游资源  : $FSTDD_SRC"
   echo
   echo " 下一步：在 WorkBuddy 中重启或执行 /reload，然后运行 /fstdd-understand"
   exit 0
