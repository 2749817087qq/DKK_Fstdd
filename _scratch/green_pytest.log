E       def parse_manifest(manifest_path: Path) -> tuple[dict[str, dict], list[str], bool]:
E           """解析 00-SIGNATURES.md。
E       
E           Returns:
E               (entries_by_name, warnings, file_exists_flag)
E               entries_by_name: filename -> {"md5": str, "timestamp": str, "emitted_by": str}
E               warnings:        list[str] — 畸形行或重复登记告警
E               file_exists_flag: True 表示文件存在（即使为空表）
E           """
E           warnings: list[str] = []
E           if not manifest_path.exists():
E               return {}, warnings, False
E       
E           text = manifest_path.read_text(encoding="utf-8", errors="replace")
E           lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
E       
E           entries: dict[str, dict] = {}
E           seen_names: dict[str, int] = {}  # filename -> first index
E       
E           for raw in lines:
E               # 跳过 markdown 表头 / 分隔线 / 纯注释
E               stripped = raw.strip("|").strip()
E               if not stripped or stripped.startswith("---") or stripped.startswith("#"):
E                   continue
E       
E               parts = [p.strip() for p in raw.strip("|").split("|")]
E               if len(parts) < 4:
E                   warnings.append(f"manifest: skipped malformed row ({parts[:2]}...)")
E                   continue
E       
E               fname, md5p, ts, by = parts[0], parts[1], parts[2], parts[3]
E       
E               # md5 前 12 位校验
E               if len(md5p) != MD5_PREFIX_LEN or not re.fullmatch(r"[0-9a-fA-F]{12}", md5p):
E                   warnings.append(f"manifest: skipped row with invalid md5 prefix for {fname}")
E                   continue
E               md5p = md5p.lower()
E       
E               # 重复登记：首条有效，后续记录告警
E               if fname in entries:
E                   warnings.append(f"manifest: duplicate entry for {fname}, using first occurrence")
E                   continue
E       
E               entries[fname] = {
E                   "md5": md5p,
E                   "timestamp": ts,
E                   "emitted_by": by,
E               }
E               seen_names[fname] = len(entries)
E       
E           return entries, warnings, True
