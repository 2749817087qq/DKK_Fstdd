E           为了测试友好，也可接受 file_path 是纯字符串。
E           """
E           file_path = Path(file_path)
E           manifest_path = file_path.parent / MANIFEST_NAME
E           entries, warnings, manifest_exists = parse_manifest(manifest_path)
E       
E           actual = _md5_prefix(_read_bytes(file_path))
E           fname = file_path.name
E       
E           if not manifest_exists:
E               return {
E                   "status": "unverified",
E                   "reason": "manifest_missing",
E                   "filename": fname,
E                   "md5_prefix": actual,
E               }
E       
E           if fname not in entries:
E               return {
E                   "status": "unverified",
E                   "reason": "not_in_manifest",
E                   "filename": fname,
E                   "md5_prefix": actual,
E               }
E       
E           expected = entries[fname]["md5"]
E           if actual != expected:
E               return {
E                   "status": "unverified",
E                   "reason": "md5_mismatch",
E                   "filename": fname,
E                   "md5_prefix": actual,
E                   "expected_md5_prefix": expected,
E               }
E       
E           return {
E               "status": "verified",
E               "filename": fname,
E               "md5_prefix": actual,
E               "emitted_by": entries[fname]["emitted_by"],
